async function searchProducts(q){
  q = (q||'').trim(); if(!q) return;
  const box = $('#search-results');
  const idx = await loadIndex();
  if(!Object.keys(idx).length){ // file:// 등 index 로드 불가
    box.innerHTML = `<div class="sr-empty">상품명 검색은 배포된 사이트에서 동작해요. 파일을 직접 열면 상품 URL로만 조회됩니다.</div>`;
    box.classList.add('on'); return;
  }
  // 띄어쓴 단어는 각각 AND로 검색 (예: "아누아 세럼" → '아누아' AND '세럼' 둘 다 포함)
  const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
  const hits = Object.entries(idx)
    .filter(([g,it]) => { const hay=((it.name||'')+' '+(it.brand||'')).toLowerCase(); return terms.every(t=>hay.includes(t)); })
    .sort((a,b)=>(a[1].name||'').length-(b[1].name||'').length)   // 짧은(대표) 상품명 우선
    .slice(0, 40);
  if(!hits.length){
    box.innerHTML = `<div class="sr-empty">‘${q}’에 해당하는 추적 상품이 없어요. 아직 추적 목록에 없거나(수집 대기), 상품 URL로 조회해보세요.</div>`;
    box.classList.add('on'); return;
  }
  if(hits.length === 1){ box.classList.remove('on'); box.innerHTML=''; loadGoods(hits[0][0]); return; }
  box.innerHTML = `<div class="sr-head">‘${q}’ 검색 결과 ${hits.length}개 — 판정서를 볼 상품을 선택하세요</div>` +
    hits.map(([g,it]) => {
      const nm=(it.name||''), br=(it.brand||'');
      const disp = (br && !nm.includes(br)) ? `<b>${br}</b> ${nm}` : nm;
      const im = it.img ? `<img class="sr-img" src="${it.img}" alt="" loading="lazy" onerror="this.remove()">` : '';
      return `<button class="sr-item" data-g="${g}">${im}<span>${disp}</span><span class="sr-cur">${(it.cur||0).toLocaleString('ko-KR')}원</span></button>`;
    }).join('');
  box.classList.add('on');
}
