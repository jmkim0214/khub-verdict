  /* 2026-08-15: 등급(합쳐서 Top 30)과 플래그(표시가 주의)를 두 계위로 나눴다.
     '정직한 가격'은 부풀림이 아니면 전부 해당돼 정보가 없어 없앴다. */
  const VC = {genuine:['v-good','✓ 진짜 할인'], watch:['v-flat','통상 가격'], hold:['v-warn','! 판정 보류']};
  const VEN = {genuine:'HOT DEAL', watch:'NO DEAL', hold:'NO VERDICT'};
  const FC = {inflated:'✕ 부풀림 신호', raised:'↑ 표시정가 인상', sale_end:'↑ 할인 종료'};
  const gradeOf = it => it.grade || (VC[it.vtype] ? it.vtype : 'watch');
  const c = d.counts || {}, fc = d.fcounts || {};
  const badN = fc.inflated||0;
  /* 2026-08-17: 관측 날짜는 뺀다 — 오늘 데이터인 게 기본값이고, 모바일에서 두 줄을 먹는다 */
  $('#t-sub').innerHTML = badN
    ? `Top 30 중 <b class="bad">${badN}개는 부풀려진 할인</b>`
    : `Top 30의 실제 가격 흐름`;
  /* 판정 칩 → 그 판정만 모아 보는 목록 (price.html?v=…) */
  const stat = (cls,label,n,v)=> n
    ? `<a class="t-stat ${cls}" href="price.html?v=${v}" title="${esc(label)} (${VEN[v]||''}) ${n}개만 모아 보기">${label} ${n}</a>` : '';
  const fstat = (label,n,f)=> n
    ? `<a class="t-fstat" href="price.html?f=${f}" title="${esc(label)} ${n}개만 모아 보기">${label} ${n}</a>` : '';
  $('#t-stats').innerHTML =
    stat('s-good','✓ 진짜 할인',c.genuine,'genuine') +
    stat('s-flat','통상 가격',c.watch,'watch') +
    stat('s-warn','! 판정 보류',c.hold,'hold');
  /* 플래그는 등급과 다른 축 — 한 계위 아래로 내린다 */
  const frow = fstat('✕ 부풀림 신호',fc.inflated,'inflated')
             + fstat('↑ 표시정가 인상',fc.raised,'raised') + fstat('↑ 할인 종료',fc.sale_end,'sale_end');
  $('#t-flags').innerHTML = frow ? `<span class="t-flabel">표시가 주의</span>${frow}` : '';
  const CW=260, CH=46, L=6, R=6, T=8, B=5;
  const mspark = it=>{
    const pts = it.series||[]; const n = pts.length; if(!n) return '';
    const vals = pts.map(p=>p[1]);
    let yMin = Math.min(...vals, it.org||Infinity), yMax = Math.max(...vals, it.org||0);
    const pad = Math.max((yMax-yMin)*0.14, yMax*0.02); yMin-=pad; yMax+=pad;
    const x = i => n>1 ? L + (i/(n-1))*(CW-L-R) : CW/2;
    const y = v => T + (CH-T-B) - ((v-yMin)/(yMax-yMin))*(CH-T-B);
    let s = `<svg viewBox="0 0 ${CW} ${CH}" aria-hidden="true">`;
    if(it.org) s += `<line x1="${L}" x2="${CW-R}" y1="${y(it.org)}" y2="${y(it.org)}" stroke="var(--muted)" stroke-width="1.1" stroke-dasharray="3 3" opacity="0.75"/>`;
    const path = pts.map((p,i)=>(i?'L':'M')+x(i).toFixed(1)+' '+y(p[1]).toFixed(1)).join('');
    s += `<path d="${path}" fill="none" stroke="var(--series)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`;
    s += `<circle cx="${x(n-1)}" cy="${y(pts[n-1][1])}" r="3.4" fill="var(--deal)" stroke="var(--surface)" stroke-width="2"/>`;
    return s + `</svg>`;
  };
  /* 미니카드 → 해당 상품의 판정서 (박스 전체가 Top 30으로 가던 동선을 분리) */
  $('#t-minis').innerHTML = d.minis.slice(0,3).map(it=>{
    const [cls,label] = VC[gradeOf(it)] || VC.watch;
    const ftags = (it.flags||[]).map(fl=>`<span class="m-flag">${FC[fl]||fl}</span>`).join('');
    const th = it.img ? `<img src="${esc(it.img)}" alt="" loading="lazy" onerror="this.parentNode.textContent='${esc((it.brand||'·').slice(0,1))}'">`
                      : esc((it.brand||'·').slice(0,1));
    /* 2026-08-15: 판정 → 가격 → 이력 → 상품 순서로 뒤집었다. 일반 쇼핑몰은 상품 사진이
       먼저지만, 더마릭 카드에서 가장 먼저 읽혀야 하는 건 판정이다. 썸네일은 하단으로. */
    /* B안과 같은 문법 — 표시가 대신 평소가 대비 (2026-08-17) */
    let real = '';
    if (it.med){
      const r = Math.round((1 - it.cur/it.med)*100);
      real = r >= 3 ? `<span class="m-real hot">평소보다 −${r}%</span>`
           : r <= -3 ? `<span class="m-real">평소보다 +${-r}%</span>`
           : `<span class="m-real">평소가 그대로</span>`;
    }
    return `<a class="t-mini" href="./?g=${esc(it.gno)}&from=home" title="${esc(it.brand)} ${esc(it.name)} 판정서 보기">
      <div class="m-top"><span class="m-chip ${cls}">${label}</span>${ftags}<span class="m-rank">${it.rank}위</span></div>
      <div class="m-price">${(it.cur||0).toLocaleString('ko-KR')}<span class="w">원</span>${real}</div>
      ${mspark(it)}
      <div class="m-foot"><div class="m-thumb">${th}</div>
        <div class="m-name">${esc(it.brand)} ${esc(it.name)}</div>
        <span class="m-go">→</span></div>
    </a>`;
  }).join('');
  $('#teaser').classList.remove('hidden');
})();
$('#back-btn').addEventListener('click', ()=>{
  if(backTo){ location.href = backTo; return; }   // 디바이스·가격 목록에서 들어왔으면 그 목록으로
  $('#url-input').value=''; show('home');
  if(location.search) history.replaceState(null, '', location.pathname);
});
$('#copy-btn').addEventListener('click', ()=>{
  const url = location.href;
  (navigator.clipboard?.writeText(url) || Promise.reject())
    .then(()=>toast('판정서 링크가 복사되었습니다'))
    .catch(()=>toast(url));
});
/* ---------- 이의제기 (실제 접수: mailto) ---------- */
const DISPUTE_EMAIL = 'themaric.official@gmail.com';   // 이의제기 접수 이메일
$('#dispute-addr').textContent = DISPUTE_EMAIL;
function openDispute(){
  const id = ($('#r-id')?.textContent || '').trim() || '(번호 없음)';
  const brand = ($('#r-brand')?.textContent || '').trim();
  const name = ($('#r-name')?.textContent || '').trim();
  const vtitle = ($('#r-vtitle')?.textContent || '').trim();
  const ctx = `${brand} ${name}\n판정서 ${id} · ${vtitle}\n${location.href}`;
  $('#dispute-ctx').textContent = ctx;
  const subject = `[더마릭 이의제기] ${id} ${brand} ${name}`.slice(0,120);
  const body =
`■ 재검토 대상\n${ctx}\n\n■ 어떤 점이 사실과 다른가요?\n(여기에 작성)\n\n■ 근거 (가격 캡처, 공식 자료 링크 등)\n(여기에 첨부/링크)\n\n■ 회신받을 연락처\n(이메일 또는 담당자)\n`;
  $('#dispute-mail').href = `mailto:${DISPUTE_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  $('#dispute-modal').style.display = 'flex';
}
$('#object-btn').addEventListener('click', openDispute);
$('#foot-dispute')?.addEventListener('click', e=>{ e.preventDefault(); openDispute(); });
$('#dispute-close').addEventListener('click', ()=>{ $('#dispute-modal').style.display='none'; });
$('#dispute-modal').addEventListener('click', e=>{ if(e.target.id==='dispute-modal') $('#dispute-modal').style.display='none'; });
$('#tg-btn').addEventListener('click', ()=>toast('텔레그램 채널은 준비 중이에요 — 오픈 소식은 이 페이지에서 알려드릴게요'));
// dev-teaser 비노출 중 — 요소가 없을 수 있어 옵셔널 처리 (복원 시 그대로 동작)
$('#api-link')?.addEventListener('click', e=>{ e.preventDefault(); toast('개발자용 API는 준비 중이에요'); });
</script>
