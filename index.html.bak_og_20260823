<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>더마릭 — 화장품 가격·성분 판정</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Noto+Serif+KR:wght@600;700&display=swap" rel="stylesheet">
<style>
  /* 브랜드 팔레트 v2 (2026-08-15) — 아이보리 / 딥올리브 / 차콜 / 골드,
     코랄은 '가격이 진짜 움직인 순간'에만. 이전 팔레트는 index.html.bak_redesign_* 참조. */
  :root{
    color-scheme: light;
    --page:#F5F1E8; --surface:#FFFEFB;
    --ink:#20221E; --ink-2:#5B5D55; --muted:#8F9184;
    --grid:rgba(32,34,30,0.10); --baseline:rgba(32,34,30,0.20);
    --border:rgba(32,34,30,0.12);
    --series:#596044; --series-wash:rgba(89,96,68,0.10);
    --gold:#B49A62; --gold-wash:rgba(180,154,98,0.14);
    /* good = 진짜 할인(올리브) · critical = 표시 할인 주의(코랄) · warn = 중립 경고(회색) */
    /* deal = 딜 판정 전용 강조(HOT DEAL). good(올리브)은 성분·안전·대안 등 일반 '좋음'에만 쓴다.
       2026-08-15: HOT/REAL 등급 통합 — 딜 칩은 코랄 채움 하나로 간다. */
    --deal:#D95C4F; --deal-bg:rgba(217,92,79,0.10);
    --good:#596044; --good-text:#4A5139;
    --warn:#6B6D62; --serious:#B4653A; --critical:#D95C4F;
    --good-bg:rgba(89,96,68,0.12); --warn-bg:rgba(32,34,30,0.05);
    --serious-bg:rgba(180,101,58,0.12); --critical-bg:rgba(217,92,79,0.10);
    --serif:"Cormorant Garamond","Noto Serif KR","Times New Roman",serif;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family:'Pretendard Variable',Pretendard,-apple-system,'Apple SD Gothic Neo','Noto Sans KR',sans-serif;
    background:var(--page); color:var(--ink);
    line-height:1.55; -webkit-font-smoothing:antialiased;
    word-break:keep-all; overflow-wrap:break-word;  /* 한글 어절 단위 줄바꿈 */
  ; overflow-x:hidden}
  .wrap{max-width:780px; margin:0 auto; padding:0 20px 80px;}
  /* 상단 밴드 — 페이지마다 본문 폭이 달라도(640·780·1080) 헤더는 항상 같은 자리·같은 폭. (2026-08-15) */
  .site-band{width:100vw; margin-left:calc(50% - 50vw); border-bottom:1px solid var(--grid); margin-bottom:18px;}
  header.site{display:flex; align-items:center; gap:10px; flex-wrap:wrap; row-gap:10px;
    max-width:780px; margin:0 auto; padding:24px 20px 14px; border-bottom:none;}
  .nav-link{align-self:center; font-size:13.5px; font-weight:600; color:var(--ink-2);
    text-decoration:none; padding:6px 2px; white-space:nowrap;}
  .nav-link + .nav-link{margin-left:20px;}
  .nav-first{margin-left:auto;}
  .nav-link:hover{color:var(--series);}
  .nav-link.here{color:var(--series); font-weight:800;}
  @media (max-width:640px){
    header.site{padding:18px 16px 12px; column-gap:18px;}
    header.site > a:first-child{width:100%;}
    .nav-link{font-size:12.5px; padding:5px 0;}
    .nav-link + .nav-link{margin-left:0;}
    .nav-first{margin-left:0;}
  }
  .logo{font-family:var(--serif); font-size:23px; font-weight:600; letter-spacing:0.20em; color:var(--ink); line-height:1.1;}
  .logo-eng{font-size:11.5px; font-weight:600; letter-spacing:0.02em; color:var(--muted); margin-left:9px; vertical-align:3px; font-family:'Pretendard Variable',Pretendard,sans-serif;}
  .logo-sub{font-family:var(--serif); font-size:10.5px; letter-spacing:0.28em; color:var(--gold); margin-top:6px; text-transform:uppercase;}
  
  .card{
    background:var(--surface); border:1px solid var(--border);
    border-radius:6px; padding:26px; margin-top:16px;
  }

  /* ---------- HOME ---------- */
  .hero{text-align:center; padding:56px 26px 44px; border:none; background:transparent;}
  .hero h1{font-size:38px; font-weight:800; letter-spacing:-0.04em; line-height:1.22;}
  .hero h1 .u{box-shadow:none; color:var(--series);}
  .hero p.lead{color:var(--ink-2); margin-top:16px; font-size:15px;}
  .hero p.lead b{color:var(--ink); font-weight:700;}
  .pillars{margin-top:18px; font-size:12.5px; color:var(--muted); letter-spacing:.02em;}
  .kakao-band{display:flex; align-items:center; justify-content:center; gap:8px;
    max-width:580px; margin:22px auto 0; padding:13px 18px; border-radius:4px;
    border:1px solid var(--baseline); background:var(--surface); text-decoration:none;
    font-size:13.5px; font-weight:700; color:var(--ink); transition:border-color .15s;}
  .kakao-band:hover{border-color:var(--deal);}
  .kakao-band .dot{width:8px; height:8px; border-radius:50%; background:var(--deal); flex:none;}
  .kakao-band .go{color:var(--deal); margin-left:2px;}
  .urlbar{display:flex; gap:8px; margin:30px auto 0; max-width:580px;}
  .urlbar input{
    flex:1; font:inherit; font-size:15px; padding:17px 18px;
    border:1.5px solid var(--ink); border-radius:4px;
    background:var(--surface); color:var(--ink); outline:none; min-width:0;
  }
  .urlbar input:focus{border-color:var(--series);}
  .urlbar input.err{border-color:var(--critical); animation:shake .3s;}
  @keyframes shake{25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}
  .btn{
    font:inherit; font-size:15px; font-weight:700; cursor:pointer; letter-spacing:.03em;
    padding:17px 30px; border-radius:4px; border:none;
    background:var(--series); color:var(--page); white-space:nowrap;
    transition:background .15s;
  }
  .btn:hover{background:var(--ink); opacity:1;}
  .btn.ghost{
    background:transparent; color:var(--ink-2);
    border:1px solid var(--baseline); font-weight:600;
    padding:12px 18px; font-size:13.5px;
  }
  .btn.ghost:hover{background:transparent; border-color:var(--ink); color:var(--ink);}
  .hint{margin-top:12px; font-size:12px; color:var(--muted);}
  #search-results{display:none; max-width:560px; margin:14px auto 0; text-align:left;}
  #search-results.on{display:block;}
  #search-results .sr-head{font-size:12.5px; color:var(--muted); margin:0 2px 8px;}
  #search-results .sr-empty{font-size:13px; line-height:1.65; color:#FDFBF5; background:var(--ink-2); border-radius:12px; padding:14px 16px;}
  #search-results .sr-img{width:38px;height:38px;border-radius:8px;object-fit:cover;flex:none;background:var(--series-wash);}
  #search-results .sr-item{display:flex; align-items:center; gap:10px; width:100%; text-align:left; background:var(--surface); border:1px solid var(--baseline); border-radius:11px; padding:9px 12px; margin-bottom:7px; font-size:13.5px; color:var(--ink); cursor:pointer; font-family:inherit;}
  #search-results .sr-item:hover{border-color:var(--series); background:var(--series-wash);}
  #search-results .sr-item b{font-weight:700; flex:none;}
  #search-results .sr-cur{margin-left:auto; font-weight:700; color:var(--series); white-space:nowrap;}
  .samples{margin-top:26px;}
  .samples .s-label{font-size:12.5px; color:var(--muted); margin-bottom:10px;}
  .chips{display:flex; gap:8px; justify-content:center; flex-wrap:wrap;}
  .chip{
    font:inherit; font-size:13px; cursor:pointer;
    padding:8px 14px; border-radius:999px;
    border:1px solid var(--baseline); background:var(--surface); color:var(--ink-2);
  }
  .chip:hover{border-color:var(--series); color:var(--ink);}
  .chip.real-chip{border-style:solid; border-color:var(--series); background:var(--series-wash);}
  .chip .dot{display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:7px; vertical-align:1px;}
  /* ---------- 메인 티저 (오늘의 가격 데이터) ---------- */
  .teaser{display:block; padding:22px 24px 20px; color:inherit; transition:border-color .15s;}
  .teaser:hover{border-color:var(--series);}
  .t-head{display:flex; align-items:flex-start; gap:14px; flex-wrap:wrap;
          text-decoration:none; color:inherit; cursor:pointer;}
  .t-head:hover .t-title{color:var(--series);}
  .t-head:hover .t-cta{text-decoration:underline; text-underline-offset:3px;}
  .t-title{font-family:var(--serif); font-size:20px; font-weight:600; letter-spacing:.16em; line-height:1.2;}
  .t-kr{font-size:13.5px; font-weight:600; color:var(--ink-2); margin-top:5px; letter-spacing:-0.01em;}
  .t-new{font-size:10px; font-weight:800; vertical-align:7px; color:var(--critical); margin-left:3px;}
  .t-sub{font-size:12.5px; color:var(--muted); margin-top:4px;}
  .t-sub b.bad{color:var(--critical);}
  .t-cta{margin-left:auto; font-size:13px; font-weight:700; color:var(--series); white-space:nowrap; padding-top:3px;}
  .t-stats{display:flex; gap:8px; margin-top:14px; flex-wrap:wrap; align-items:center;}
  .t-stat{font-size:12px; font-weight:700; border-radius:999px; padding:4px 12px;
          text-decoration:none; display:inline-block; border:1px solid transparent;
          transition:filter .12s, border-color .12s;}
  a.t-stat:hover{filter:brightness(0.94); border-color:currentColor;}
  /* 딜 판정 = 알약형 코랄 채움 (사이트·카드·핫딜방 공통) */
  .t-stat.s-good{background:var(--deal); color:#FFFEFB; border-color:var(--deal);}
  /* 부풀림 신호 = 등급이 아니라 경고 플래그 → 사각형 · 회색 테두리 · 코랄 글씨.
     채움/외곽선과 알약/사각형 두 축으로 갈려서 등급으로 오독되지 않는다. (2026-08-15) */
  .t-stat.s-bad{background:transparent; color:var(--critical); border-color:var(--baseline); border-radius:2px;}
  .t-stat.s-flat{background:transparent; color:var(--ink-2); border-color:var(--baseline);}
  .t-stat.s-warn{background:transparent; color:var(--ink-2); border-color:var(--baseline); border-style:dashed;}
  .t-stats-hint{font-size:11.5px; color:var(--muted);}
  /* 표시가 플래그 — 등급 칩보다 한 계위 아래 (작게, 사각형) */
  .t-flags{display:flex; gap:8px; margin-top:9px; flex-wrap:wrap; align-items:center;
           padding-top:9px; border-top:1px solid var(--grid);}
  .t-flabel{font-size:11.5px; color:var(--muted);}
  .t-fstat{font-size:11.5px; font-weight:700; color:var(--critical); text-decoration:none;
           border:1px solid var(--baseline); border-radius:3px; padding:3px 9px;}
  .t-fstat:hover{border-color:var(--critical);}
  .t-minis{display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:16px;}
  @media (max-width:640px){.t-minis{grid-template-columns:1fr;}}
  .t-mini{border:1px solid var(--border); border-radius:11px; padding:12px 13px 9px; background:var(--page);
          text-decoration:none; color:inherit; display:block; transition:border-color .15s, background .15s;}
  a.t-mini:hover{border-color:var(--series); background:var(--series-wash);}
  a.t-mini:hover .m-name{color:var(--series);}
  .t-mini .m-top{display:flex; align-items:center; gap:6px;}
  .t-mini .m-flag{font-size:10px; font-weight:700; color:var(--critical); border:1px solid var(--baseline);
                  border-radius:3px; padding:1px 6px; white-space:nowrap;}
  .t-mini .m-rank{margin-left:auto; font-size:11px; color:var(--muted); font-weight:600;}
  .t-mini .m-go{font-size:13px; font-weight:700; color:var(--series); margin-left:auto; flex:none;}
  .t-mini .m-foot{display:flex; align-items:center; gap:8px; margin-top:10px;
    padding-top:10px; border-top:1px solid var(--grid);}
  .t-mini .m-thumb{width:28px; height:28px; border-radius:4px; flex:none; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
    background:var(--series-wash); border:1px solid var(--border);
    font-size:12px; font-weight:800; color:var(--series);}
  .t-mini .m-thumb img{width:100%; height:100%; object-fit:cover;}
  .t-mini .m-name{font-size:11.5px; font-weight:600; line-height:1.35; color:var(--ink-2);
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;}
  /* 가격이 카드에서 가장 강한 요소 */
  .t-mini .m-price{font-size:26px; font-weight:800; margin-top:10px; letter-spacing:-0.03em;
    font-variant-numeric:tabular-nums; display:flex; align-items:baseline; gap:8px; flex-wrap:wrap;}
  .t-mini .m-price .w{font-size:14px; font-weight:600; margin-left:-3px;}
  .t-mini .m-real{font-size:11.5px; font-weight:600; color:var(--muted); letter-spacing:0;}
  .t-mini .m-real.hot{color:var(--critical); font-weight:800;}
  .t-mini .m-chip{font-size:10.5px; font-weight:700; border-radius:999px; padding:1px 8px; border:1px solid transparent;}
  .t-mini .m-chip.v-good{background:var(--deal); color:#FFFEFB; border-color:var(--deal);}
  .t-mini .m-chip.v-bad{background:transparent; color:var(--critical); border-color:var(--baseline); border-radius:2px;}
  .t-mini .m-chip.v-warn{background:transparent; color:var(--ink-2); border:1px dashed var(--baseline);}
  .t-mini .m-chip.v-flat{background:transparent; color:var(--ink-2); border:1px solid var(--baseline);}
  .t-mini svg{display:block; width:100%; height:auto; margin-top:5px;}
  .t-foot{text-align:center; font-size:12.5px; color:var(--muted); margin-top:14px;
    border-top:1px solid var(--grid); padding-top:12px;}
  .t-foot b{color:var(--ink-2);}
  .trust{display:flex; justify-content:center; gap:64px; flex-wrap:wrap; margin-top:34px;}
  .trust .t{text-align:center; padding:0;}
  .trust .t b{display:block; font-family:var(--serif); font-size:32px; font-weight:600;
              letter-spacing:0; line-height:1; color:var(--ink); font-variant-numeric:tabular-nums;
              white-space:nowrap;}
  /* '+' 처럼 숫자 안에 든 span까지 블록이 되어 줄이 갈리던 문제 — 직계만 블록 (2026-08-15) */
  .trust .t > span{display:block; font-size:12px; color:var(--muted); margin-top:8px; line-height:1.5;}
  .trust .t b span{display:inline; color:inherit; margin:0;}
  .why-line{text-align:center; font-size:12px; color:var(--muted); margin-top:14px; line-height:1.7;}
  .why-line b{color:var(--ink-2);}
  .trust .t span b{display:inline; font-family:inherit; font-size:12.5px; font-weight:700; color:var(--ink-2);}

  /* ---------- LOADING ---------- */
  .loading{padding:48px 26px; max-width:420px; margin:0 auto;}
  .loading .step{display:flex; align-items:center; gap:11px; padding:8px 0; font-size:14.5px; color:var(--muted); transition:color .2s;}
  .loading .step.on{color:var(--ink);}
  .loading .step .ic{width:20px; height:20px; border-radius:50%; border:1.5px solid var(--baseline); flex:none;
    display:flex; align-items:center; justify-content:center; font-size:11px; color:var(--page); background:transparent;}
  .loading .step.on .ic{background:var(--series); border-color:var(--series);}
  .loading .step.now .ic{border-color:var(--series); border-top-color:transparent; animation:spin .7s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* ---------- REPORT ---------- */
  .report-top{display:flex; justify-content:space-between; align-items:center; margin-top:22px; gap:10px; flex-wrap:wrap;}
  .rid{font-size:12.5px; color:var(--muted); font-variant-numeric:tabular-nums;}
  .rid b{color:var(--ink-2); font-weight:600;}
  .back{font:inherit; font-size:13px; background:none; border:none; color:var(--ink-2); cursor:pointer; padding:4px 0;}
  .back:hover{color:var(--ink);}

  /* 추적 정지 — 21일 이상 미관측이라 가격 갱신이 멈춘 상품 (2026-08-12) */
  .paused-bar{display:flex; gap:10px; align-items:flex-start; margin:0 0 16px;
    padding:11px 13px; border-radius:10px; background:var(--warn-bg);
    border:1px solid rgba(194,147,47,0.45);}
  .paused-bar .pb-ico{font-size:15px; line-height:1.35; flex:none;}
  .paused-bar .pb-t{font-size:13px; font-weight:800; color:var(--warn); letter-spacing:-0.01em;}
  .paused-bar .pb-s{font-size:12.5px; color:var(--ink-2); margin-top:3px; line-height:1.55;}
  .prod.is-paused .thumb, .prod.is-paused .price-row{opacity:0.6;}
  .prod .stale-note{font-size:11.5px; color:var(--warn); font-weight:700; margin-top:4px;}

  .prod{display:flex; gap:16px; align-items:flex-start;}
  .thumb{width:72px; height:72px; border-radius:12px; flex:none;
    display:flex; align-items:center; justify-content:center; font-size:32px;
    background:var(--series-wash); border:1px solid var(--border);}
  .prod .brand{font-size:12.5px; color:var(--muted); font-weight:600;}
  .prod .name{display:block; font-size:16.5px; font-weight:700; letter-spacing:-0.01em; line-height:1.4;
              color:inherit; text-decoration:none;}
  .prod a.name:hover{color:var(--series); text-decoration:underline; text-underline-offset:3px;}
  .oy-cta{display:inline-block; margin-top:10px; font-size:13px; font-weight:700; color:#fff;
          background:var(--series); border-radius:999px; padding:8px 15px; text-decoration:none;}
  .oy-cta:hover{filter:brightness(1.08);}
  .oy-cta.hidden{display:none;}
  .empty-sec{margin-top:12px; padding:15px 16px; border:1px dashed var(--baseline); border-radius:12px;
             background:var(--surface);}
  .empty-sec .es-t{font-size:14px; font-weight:700;}
  .empty-sec .es-b{font-size:12.5px; color:var(--ink-2); line-height:1.75; margin-top:6px;}
  .empty-sec a{color:var(--series); font-weight:700;}
  .thumb a{display:block; width:100%; height:100%;}
  .prod .opt{font-size:12.5px; color:var(--muted); margin-top:2px;}
  .prod .price-row{margin-top:8px; display:flex; align-items:baseline; gap:9px; flex-wrap:wrap;}
  .prod .cur{font-size:21px; font-weight:800;}
  .prod .strike{font-size:13.5px; color:var(--muted); text-decoration:line-through;}
  .prod .dc{font-size:13.5px; font-weight:700; color:var(--critical);}

  /* 판정 패널 — 증서 느낌. 상단에 serif 커커, 좌측에 판정색 라인 (2026-08-15) */
  .verdict{border-radius:4px; padding:18px 22px 20px; margin:0 0 20px;
           background:var(--page); border:1px solid var(--border); border-left:3px solid var(--baseline);}
  .prod{padding-top:20px; border-top:1px solid var(--grid);}
  .verdict .v-kicker{font-family:var(--serif); font-size:11px; letter-spacing:.30em;
                     text-transform:uppercase; color:var(--gold); margin-bottom:12px;}
  .verdict .v-main{display:flex; gap:14px; align-items:flex-start;}
  .verdict.v-good{background:var(--deal-bg); border-color:rgba(217,92,79,0.22); border-left-color:var(--deal);}
  .verdict.v-bad{background:var(--critical-bg); border-color:rgba(217,92,79,0.28); border-left-color:var(--critical);}
  .verdict.v-warn{background:var(--warn-bg); border-left-color:var(--baseline);}
  .verdict .v-ic{font-size:22px; line-height:1.3;}
  .verdict h2{font-size:18px; font-weight:800; letter-spacing:-0.02em;}
  .verdict.v-good h2{color:var(--deal);}
  .verdict.v-bad h2{color:var(--critical);}
  .verdict.v-warn h2{color:var(--ink);}
  .verdict p{font-size:14px; color:var(--ink-2); margin-top:5px;}

  .sec-h{display:flex; align-items:baseline; gap:8px; margin:0 0 4px;}
  .sec-h h3{font-size:15.5px; font-weight:800; letter-spacing:-0.01em;}
  .sec-h .tag{font-size:11px; color:var(--muted); border:1px solid var(--baseline); border-radius:999px; padding:1px 8px;}
  .sec-sub{font-size:13px; color:var(--muted); margin-bottom:14px;}

  .tiles{display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:16px;}
  @media (max-width:600px){.tiles{grid-template-columns:repeat(2,1fr);}}
