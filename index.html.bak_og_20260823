let SEARCH_INDEX = null;
async function loadIndex(){
  if(SEARCH_INDEX) return SEARCH_INDEX;
  try{ const r = await fetch('verdicts/index.json', {cache:'no-store'});
       if(r.ok){ SEARCH_INDEX = (await r.json()).items || {}; } }
