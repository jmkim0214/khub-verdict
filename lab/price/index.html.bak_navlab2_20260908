    font-family:'Pretendard Variable',Pretendard,sans-serif;}
  .logo-sub{font-family:var(--serif); font-size:10.5px; letter-spacing:0.28em; color:var(--gold); margin-top:6px; text-transform:uppercase;}
  .nav-link{align-self:center; font-size:13.5px; font-weight:600; color:var(--ink-2); text-decoration:none; padding:6px 2px; white-space:nowrap;}
  .nav-link + .nav-link{margin-left:20px;}
  .nav-first{margin-left:auto;}
  .nav-link:hover{color:var(--series);} .nav-link.here{color:var(--series); font-weight:800;}

  .eyebrow{font-family:var(--serif); font-size:11px; letter-spacing:0.28em; color:var(--gold); text-transform:uppercase;}
  h1{font-size:29px; font-weight:800; letter-spacing:-0.035em; line-height:1.28; margin:10px 0 10px;}
  h2{font-size:20px; font-weight:800; letter-spacing:-0.02em; line-height:1.35;}
  .lead{font-size:15px; color:var(--ink-2);}
  .rule{height:1px; background:var(--grid); margin:22px 0;}
  .note{font-size:12.5px; color:var(--muted); line-height:1.7;}

  input[type=text],input[type=tel]{width:100%; font-family:inherit; font-size:16px; padding:13px 14px;
    border:1px solid var(--border); border-radius:4px; background:var(--surface); color:var(--ink);}
  input:focus{outline:2px solid var(--series); outline-offset:-1px; border-color:transparent;}
  button{font-family:inherit; cursor:pointer; border-radius:4px; font-size:15px;}
  .btn{background:var(--series); color:#fff; border:none; padding:14px 18px; width:100%; font-weight:600;}
  .btn:hover{filter:brightness(1.08);}
  .btn.ghost{background:transparent; color:var(--ink); border:1px solid var(--border);}
  .btn.ghost:hover{border-color:var(--series);}
  .linkbtn{background:none; border:none; color:var(--muted); font-size:13px; text-decoration:underline;
    text-underline-offset:3px; padding:6px 0; width:auto;}
  .stack{display:flex; flex-direction:column; gap:10px;}
  .err{color:var(--deal); font-size:13px;}

  .hits{display:flex; flex-direction:column; gap:0; margin-top:10px; border:1px solid var(--border);
    border-radius:4px; background:var(--surface); overflow:hidden; max-height:340px; overflow-y:auto;}
  .hit{display:flex; gap:11px; align-items:center; padding:11px 13px; text-align:left; background:none;
    border:none; border-bottom:1px solid var(--grid); width:100%;}
  .hit:last-child{border-bottom:none;}
  .hit:hover{background:var(--series-wash);}
  .hit img{width:38px; height:38px; border-radius:3px; flex:none; object-fit:cover; background:var(--grid);}
  .hit .t{flex:1; min-width:0;}
  .hit .b{font-size:11.5px; color:var(--muted);}
  .hit .n{font-size:13.5px; line-height:1.4;}

  .prod{display:flex; gap:13px; align-items:center; background:var(--surface); border:1px solid var(--border);
    border-radius:4px; padding:13px 14px;}
  .prod img{width:52px; height:52px; border-radius:3px; flex:none; object-fit:cover; background:var(--grid);}

  .verdict{font-family:var(--serif); font-size:30px; font-weight:700; letter-spacing:-0.02em; line-height:1.3; margin:2px 0 8px;}
  .big{font-family:var(--mono); font-size:15px; font-variant-numeric:tabular-nums;}
  .levels{display:flex; flex-direction:column; gap:9px; margin-top:6px;}
  .lv{display:grid; grid-template-columns:92px 1fr auto; align-items:center; gap:11px; font-size:13px;}
  .lv .p{font-family:var(--mono); font-variant-numeric:tabular-nums; text-align:right; letter-spacing:-0.02em;}
  .lv .track{height:20px; background:var(--grid); border-radius:2px; overflow:hidden;}
  .lv .track i{display:block; height:100%; background:var(--series); opacity:.30;}
  .lv .d{font-family:var(--mono); font-size:11.5px; color:var(--muted); font-variant-numeric:tabular-nums; white-space:nowrap;}
  .lv.me .track i{opacity:1; background:var(--gold);}
  .lv.me .p{font-weight:700;}
  .lv.me .d{color:var(--ink); font-weight:600;}
  .lv.cheap .track i{background:var(--series); opacity:.55;}
  .youtag{display:inline-block; background:var(--gold-wash); color:#8A7440; font-size:10.5px; font-weight:700;
    padding:1px 6px; border-radius:999px; margin-left:6px; vertical-align:1px;}
  .stats{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--grid);
    border:1px solid var(--border); border-radius:4px; overflow:hidden; margin-top:4px;}
  .stat{background:var(--surface); padding:11px 12px;}
  .stat .k{font-size:11px; color:var(--muted); letter-spacing:0.02em;}
  .stat .v{font-family:var(--mono); font-size:15px; font-variant-numeric:tabular-nums; margin-top:2px;}
  .cav{background:var(--gold-wash); border-radius:4px; padding:11px 13px; font-size:12.5px; color:#7A6738; line-height:1.65;}
  .foot{margin-top:30px; font-size:12.5px; color:var(--muted); line-height:1.7;}
  .foot a{color:var(--ink-2);}
  .hide{display:none!important;}
  @media (max-width:520px){
    header.site > a:first-child{width:100%;}
    .nav-link{font-size:12.5px; padding:5px 0;} .nav-link + .nav-link{margin-left:14px;} .nav-first{margin-left:0;}
    h1{font-size:24px;} .verdict{font-size:25px;}
    .lv{grid-template-columns:80px 1fr auto; gap:8px; font-size:12.5px;}
    .stats{grid-template-columns:1fr 1fr;}
  }
