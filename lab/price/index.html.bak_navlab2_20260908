<style>
  :root{
    color-scheme: light;
    --page:#F5F1E8; --surface:#FFFEFB;
    --ink:#20221E; --ink-2:#5B5D55; --muted:#8F9184;
    --grid:rgba(32,34,30,0.10); --border:rgba(32,34,30,0.12);
    --series:#596044; --series-wash:rgba(89,96,68,0.10);
    --gold:#B49A62; --gold-wash:rgba(180,154,98,0.14);
    --deal:#D95C4F; --deal-bg:rgba(217,92,79,0.10);
    --serif:"Cormorant Garamond","Noto Serif KR","Times New Roman",serif;
    --mono:ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{font-family:'Pretendard Variable',Pretendard,-apple-system,'Apple SD Gothic Neo','Noto Sans KR',sans-serif;
    background:var(--page); color:var(--ink); line-height:1.55; -webkit-font-smoothing:antialiased;
    word-break:keep-all; overflow-wrap:break-word; overflow-x:hidden;}
  .wrap{max-width:640px; margin:0 auto; padding:0 20px 80px;}
  .site-band{width:100vw; margin-left:calc(50% - 50vw); border-bottom:1px solid var(--grid); margin-bottom:18px;}
  header.site{display:flex; align-items:center; gap:10px; flex-wrap:wrap; row-gap:10px;
