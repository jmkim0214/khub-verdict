<script>
const $=s=>document.querySelector(s);
const app=()=>$("#app");
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const won=n=>Number(n).toLocaleString("ko-KR")+"원";
const VD="../../verdicts/";
let INDEX=null, PICK=null;

function show(h){app().innerHTML=h; window.scrollTo(0,0);}

/* ───────── 1. 검색 ───────── */
function viewHome(msg){
  show('<p class="eyebrow">Lab 02 · Price</p>'+
  '<h1>그때 그 가격,<br>잘 샀을까?</h1>'+
  '<p class="lead">샀던 화장품과 기억나는 가격을 넣어보세요. 더마릭이 하루 두 번 관측한 가격대 중 '+
  '어디였는지, 며칠짜리 가격이었는지 알려드려요.</p>'+
  '<div class="rule"></div>'+
  '<div class="stack">'+
  '<label class="eyebrow" for="q">상품 이름</label>'+
  '<input type="text" id="q" placeholder="예) 아누아 어성초 토너" autocomplete="off">'+
  '<button class="btn" id="go">찾기</button>'+
  (msg?'<p class="err">'+esc(msg)+'</p>':"")+
  '</div><div id="hits"></div>'+
  '<p class="note" style="margin-top:22px">브랜드명을 같이 넣으면 더 잘 찾아요. 올리브영에서 판매하는 상품만 조회됩니다.</p>');
  $("#go").onclick=doSearch;
  $("#q").onkeydown=e=>{if(e.key==="Enter")doSearch();};
  $("#q").focus();
}

async function loadIndex(){
  if(INDEX) return INDEX;
  try{
    const r=await fetch(VD+"index.json",{cache:"force-cache"});
    INDEX=r.ok?((await r.json()).items||{}):{};
  }catch(e){ INDEX={}; }
  return INDEX;
}

async function doSearch(){
  const q=($("#q").value||"").trim();
  const box=$("#hits");
  if(q.length<2){ box.innerHTML='<p class="err" style="margin-top:10px">두 글자 이상 입력해 주세요.</p>'; return; }
  box.innerHTML='<p class="note" style="margin-top:12px">상품 목록을 불러오는 중이에요…</p>';
  const idx=await loadIndex();
  if(!Object.keys(idx).length){
    box.innerHTML='<p class="err" style="margin-top:10px">상품 목록을 불러오지 못했어요. 잠시 후 다시 시도해 주세요.</p>'; return;
  }
  const terms=q.toLowerCase().split(/\s+/).filter(Boolean);
  const hits=Object.entries(idx)
    .filter(([g,it])=>{const hay=((it.name||"")+" "+(it.brand||"")).toLowerCase(); return terms.every(t=>hay.includes(t));})
    .sort((a,b)=>(a[1].name||"").length-(b[1].name||"").length)
    .slice(0,30);
  if(!hits.length){
    box.innerHTML='<p class="note" style="margin-top:12px">찾는 상품이 없어요. 브랜드명만으로도 검색해 보세요.</p>'; return;
  }
  box.innerHTML='<div class="hits">'+hits.map(([g,it])=>
    '<button class="hit" data-g="'+g+'">'+
    (it.img?'<img src="'+esc(it.img)+'" alt="" loading="lazy" onerror="this.style.visibility=\'hidden\'">':'<img alt="">')+
    '<span class="t"><span class="b">'+esc(it.brand||"")+'</span>'+
    '<span class="n">'+esc(it.name||"")+'</span></span></button>').join("")+'</div>';
  box.querySelectorAll(".hit").forEach(b=>b.onclick=()=>viewPrice(b.dataset.g));
}

/* ───────── 2. 가격 입력 ───────── */
async function viewPrice(gno, preset){
  show('<p class="note">불러오는 중…</p>');
  let j=null;
  try{ const r=await fetch(VD+gno+".json",{cache:"force-cache"}); if(r.ok) j=await r.json(); }catch(e){}
  if(!j){ viewHome("그 상품의 가격 기록을 찾지 못했어요."); return; }
  PICK={gno:gno,j:j};
  show(prodCard(j)+
  '<div class="rule"></div>'+
  '<div class="stack">'+
  '<label class="eyebrow" for="p">내가 산 가격</label>'+
  '<input type="tel" id="p" inputmode="numeric" placeholder="예) 19800" value="'+(preset||"")+'">'+
  '<p class="err hide" id="pe">숫자로 가격을 입력해 주세요.</p>'+
  '<button class="btn" id="ok">결과 보기</button>'+
  '<button class="linkbtn" id="back">다른 상품 찾기</button>'+
  '</div>'+
  '<p class="note" style="margin-top:18px">할인·쿠폰을 적용해 <b>실제로 결제한 금액</b>을 넣어주세요. 기억이 흐릿하면 대략도 괜찮아요.</p>');
  $("#p").oninput=()=>$("#pe").classList.add("hide");
  $("#p").onkeydown=e=>{if(e.key==="Enter")submit();};
  $("#ok").onclick=submit;
  $("#back").onclick=()=>{location.hash="";viewHome();};
  $("#p").focus();
  function submit(){
    const v=parseInt(($("#p").value||"").replace(/[^0-9]/g,""),10);
    if(!v||v<100||v>3000000){ $("#pe").classList.remove("hide"); return; }
    location.hash="#g="+gno+"&p="+v;
  }
}

function prodCard(j){
  return'<div class="prod">'+
    (j.img?'<img src="'+esc(j.img)+'" alt="" onerror="this.style.visibility=\'hidden\'">':'<img alt="">')+
    '<div><div class="hit-b" style="font-size:11.5px;color:var(--muted)">'+esc(j.brand||"")+'</div>'+
    '<div style="font-size:14.5px;line-height:1.4">'+esc(j.name||"")+'</div></div></div>';
}

/* ───────── 3. 결과 ───────── */
function analyze(series, mine){
  const prices=series.map(p=>p.price).filter(p=>p);
  const n=prices.length;
  const cnt={};
  prices.forEach(p=>cnt[p]=(cnt[p]||0)+1);
  const levels=Object.keys(cnt).map(Number).sort((a,b)=>a-b).map(p=>({p:p,c:cnt[p]}));
  const cheaper=prices.filter(p=>p<mine).length;
  const same=cnt[mine]||0;
  const pricier=n-cheaper-same;
  const mid=(cheaper+same/2)/n;
  const min=levels[0].p, max=levels[levels.length-1].p;
  const mode=levels.slice().sort((a,b)=>b.c-a.c)[0].p;
  return{n:n,levels:levels,cheaper:cheaper,same:same,pricier:pricier,mid:mid,min:min,max:max,mode:mode};
}
function headline(a,mine){
  if(mine< a.min) return["관측된 어떤 날보다 쌌어요","이 기간엔 이만큼 싼 값이 나온 적이 없어요."];
  if(mine===a.min) return["관측 최저가예요","이보다 싼 날은 없었어요."];
  if(mine> a.max) return["관측된 어떤 날보다 비쌌어요","이 기간엔 이보다 싼 값만 나왔어요."];
  if(mine===a.max) return["가장 비쌌던 가격이에요","관측된 날 대부분이 이보다 쌌어요."];
  const r=a.mid;
  if(r<=0.15) return["싸게 산 편이에요","이보다 싼 날이 드물었어요."];
  if(r<=0.42) return["조금 싸게 샀어요","중간보다는 아래였어요."];
  if(r<=0.62) return["평범한 가격이었어요","이 상품이 자주 머무는 가격대예요."];
  if(r<=0.85) return["비싼 편이었어요","더 싼 날이 꽤 있었어요."];
  return["거의 가장 비쌌어요","대부분의 날이 이보다 쌌어요."];
}
function viewResult(gno, mine){
  const j=PICK && PICK.gno===gno ? PICK.j : null;
  if(!j){ viewPrice(gno, mine); return; }
  const series=((j.chart||{}).series||[]).filter(p=>p.price);
  if(series.length<8){
    show(prodCard(j)+'<div class="rule"></div><h2>아직 비교할 만큼 쌓이지 않았어요</h2>'+
      '<p class="lead" style="margin-top:8px">이 상품은 관측 기록이 '+series.length+'회뿐이라 가격대를 말하기 어려워요. '+
      '관측은 매일 이어지고 있어요.</p><div class="stack" style="margin-top:16px">'+
      '<button class="btn ghost" id="back">다른 상품 찾기</button></div>');
    $("#back").onclick=()=>{location.hash="";viewHome();};
    return;
  }
  const a=analyze(series,mine);
  const h=headline(a,mine);
  const first=(series[0].label||"").split("·")[0], last=(series[series.length-1].label||"").split("·")[0];
  const maxc=Math.max.apply(null,a.levels.map(l=>l.c));
  const inLv=a.levels.some(l=>l.p===mine);

  // 가격대 막대 (내 가격이 관측에 없으면 그 자리에 끼워 표시)
  let rows=a.levels.map(l=>({p:l.p,c:l.c,me:l.p===mine}));
  if(!inLv) rows.push({p:mine,c:0,me:true});
  rows.sort((x,y)=>x.p-y.p);

  show(prodCard(j)+
  '<div class="rule"></div>'+
  '<p class="eyebrow">'+esc(won(mine))+'에 샀다면</p>'+
  '<p class="verdict">'+esc(h[0])+'</p>'+
  '<p class="lead">'+esc(h[1])+' 관측 '+a.n+'회 중 — 더 싼 값 <b>'+a.cheaper+'회</b>'+
    (a.same?' · 같은 값 <b>'+a.same+'회</b>':"")+
    (a.pricier?' · 더 비싼 값 <b>'+a.pricier+'회</b>':"")+'.</p>'+

  '<div class="stats">'+
    '<div class="stat"><div class="k">관측 최저</div><div class="v">'+won(a.min)+'</div></div>'+
    '<div class="stat"><div class="k">가장 흔한 값</div><div class="v">'+won(a.mode)+'</div></div>'+
    '<div class="stat"><div class="k">관측 최고</div><div class="v">'+won(a.max)+'</div></div>'+
  '</div>'+

  '<div class="rule"></div>'+
  '<p class="eyebrow">가격대별 관측 횟수</p>'+
  '<div class="levels">'+rows.map(function(l){
    const cls="lv"+(l.me?" me":"")+(!l.me&&l.p<mine?" cheap":"");
    const w=maxc?Math.max(l.c/maxc*100,l.c?4:0):0;
    return'<div class="'+cls+'"><span class="p">'+won(l.p)+(l.me?'<span class="youtag">나</span>':"")+'</span>'+
      '<span class="track"><i style="width:'+w.toFixed(1)+'%"></i></span>'+
      '<span class="d">'+(l.c?l.c+"회":"관측 없음")+'</span></div>';
  }).join("")+'</div>'+
  '<p class="note" style="margin-top:10px">'+esc(first)+' ~ '+esc(last)+
    (j.chartSub?' · '+esc(j.chartSub):"")+' · 기록 '+a.n+'회</p>'+

  (!inLv?'<div class="cav" style="margin-top:14px">이 가격은 관측 기록에 없어요. 쿠폰·카드 할인이나 '+
    '옵션(용량·구성)이 달랐을 수 있어요.</div>':"")+
  '<div class="cav" style="margin-top:10px">올리브영 목록에 <b>대표로 표시된 가격</b> 기준이에요. '+
    '옵션이 여러 개인 상품은 고른 옵션에 따라 실제 가격이 달랐을 수 있습니다.</div>'+

  '<div class="rule"></div>'+
  '<div class="stack">'+
    '<button class="btn" id="share">결과 링크 복사하기</button>'+
    '<a class="btn ghost" style="display:block;text-align:center;text-decoration:none;line-height:1.4" '+
      'href="../../?g='+esc(gno)+'&from=lab-price">이 상품 판정서 보기 →</a>'+
    '<button class="linkbtn" id="again">다른 상품도 확인하기</button>'+
  '</div>'+
  '<p class="foot">더마릭은 올리브영 가격을 하루 두 번 관측해 기록합니다. '+
    '표시 할인율이 아니라 실제로 관측된 가격만 씁니다. <a href="../">LAB의 다른 실험 보기</a></p>');

  $("#again").onclick=()=>{location.hash="";viewHome();};
  $("#share").onclick=async function(){
    const url=location.origin+location.pathname+"#g="+gno+"&p="+mine;
    const msg=(j.name||"")+" "+won(mine)+" — "+h[0]+"\n"+url;
    try{ await navigator.clipboard.writeText(msg); this.textContent="복사됐어요"; }
    catch(e){ this.textContent="주소창의 링크를 복사해 주세요"; }
  };
}

/* ───────── 라우팅 ───────── */
function route(){
  const m=/^#g=([A-Z0-9]+)(?:&p=(\d+))?/.exec(location.hash||"");
  if(m && m[2]) return viewResult(m[1], parseInt(m[2],10));
  if(m)         return viewPrice(m[1]);
  viewHome();
}
window.addEventListener("hashchange",route);
route();
</script>
