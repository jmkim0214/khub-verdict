const $ = s => document.querySelector(s);
const won = n => n.toLocaleString('ko-KR') + '원';
const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
/* 등급(합쳐서 Top 30) / 플래그(등급과 별개 축) — 2026-08-15 */
const VCHIP = {
  genuine:['v-good','✓ 진짜 할인'], watch:['v-flat','통상 가격'], hold:['v-warn','! 판정 보류'],
};
const VEN = {genuine:'HOT DEAL', watch:'NO DEAL', hold:'NO VERDICT'};
const FCHIP = {inflated:'✕ 부풀림 신호', raised:'↑ 표시정가 인상', sale_end:'↑ 할인 종료'};
const gradeOf = it => it.grade || (VCHIP[it.vtype] ? it.vtype : 'watch');
/* B안 (2026-08-17): 주인공 = 평소가 대비 실질 할인. 올영 표시는 아래 인용 줄로.
   근거(판 날 N일/M일)를 표시율 바로 옆에 붙인다 — 부풀림 신호의 이유가 즉석에서 보인다. */
function realTag(it){
  if (!it.med) return '';
  const r = Math.round((1 - it.cur/it.med)*100);
  if (r >= 3) return `<span class="real hot">평소보다 −${r}%</span>`;
  if (r <= -3) return `<span class="real up">평소보다 +${-r}%</span>`;
  return `<span class="real zero">평소가 그대로</span>`;
}
function shownLine(it){
  const dc = (it.org && it.org > it.cur) ? Math.round((1-it.cur/it.org)*100) : 0;
  if (!dc) return `<div class="shown-sub">할인 표시 없음</div>`;
  const g = gradeOf(it);
  if (g === 'genuine')
    return `<div class="shown-sub">올영 표시 할인 ${dc}% — <b class="ok">실제 이력과 일치</b></div>`;
  const r = it.med ? Math.max(0, Math.round((1 - it.cur/it.med)*100)) : 0;
  return `<div class="shown-sub">올영 표시 정가는 ${won(it.org)}이지만 관측 가격은 ${won(it.med||it.cur)} — 실질 할인 ${r}%</div>`;
}
const flagsOf = it => it.flags || [];
/* 오늘 관측이면 날짜 생략 — 어제 이전 데이터일 때만 날짜를 보여 정직하게 (2026-08-17) */
{
  const today = new Date();
  const ymd = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
  $('#obs-label').textContent = META.obs_date === ymd
    ? META.obs_label.replace(META.obs_date, '오늘').trim()
    : META.obs_label;
}

/* ---------- 스파크 차트 ---------- */
const CW=260, CH=84, L=6, R=6, T=12, B=6;
function spark(it){
  const pts = it.series, n = pts.length;
  if(!n) return '';
  const vals = pts.map(p=>p[1]);
  let yMin = Math.min(...vals, it.org||Infinity), yMax = Math.max(...vals, it.org||0);
  const pad = Math.max((yMax-yMin)*0.14, yMax*0.02);
  yMin -= pad; yMax += pad;
  const x = i => n>1 ? L + (i/(n-1))*(CW-L-R) : CW/2;
  const y = v => T + (CH-T-B) - ((v-yMin)/(yMax-yMin))*(CH-T-B);
  let s = `<svg viewBox="0 0 ${CW} ${CH}" role="img" aria-label="${esc(it.name)} 일자별 가격">`;
  if(it.org) s += `<line x1="${L}" x2="${CW-R}" y1="${y(it.org)}" y2="${y(it.org)}"
        stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.75"/>`;
  const d = pts.map((p,i)=>(i?'L':'M')+x(i).toFixed(1)+' '+y(p[1]).toFixed(1)).join('');
  if(n>1) s += `<path d="${d}L${x(n-1).toFixed(1)} ${CH-B}L${x(0).toFixed(1)} ${CH-B}Z" fill="var(--series-wash)"/>`;
  s += `<path d="${d}" fill="none" stroke="var(--series)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`;
  s += `<circle cx="${x(n-1)}" cy="${y(pts[n-1][1])}" r="3.5" fill="var(--series)" stroke="var(--surface)" stroke-width="2"/>`;
  if(it.days < 5) s += `<text x="${L+2}" y="${T+22}" font-size="9.5" fill="var(--muted)">관측 ${it.days}일 — 이력 축적 중</text>`;
  s += `<rect x="0" y="0" width="${CW}" height="${CH}" fill="transparent" class="hover"/>`;
  s += `</svg>`;
  return s;
}

/* ---------- 카드 렌더 ----------
   state.cat = 카테고리 탭 키 / state.v = 판정 필터 (''이면 전체).
   메인 티저의 판정 칩이 price.html?v=inflated 형태로 여기 바로 들어온다. */
const state = {cat:'all', v:'', f:''};
const VORDER = ['genuine','watch','hold'];
const FORDER = ['inflated','raised','sale_end'];
function render(){
  const tab = TABS.find(t=>t.key===state.cat) || TABS[0];
  let items = state.v ? tab.items.filter(it=>gradeOf(it)===state.v) : tab.items;
  if(state.f) items = items.filter(it=>flagsOf(it).includes(state.f));
  const view = {items};
  const eg = $('#empty-grid');
  if(!items.length){
    const lbl = state.f ? FCHIP[state.f] : (VCHIP[state.v]||['','해당 판정'])[1];
    eg.classList.remove('hidden');
    eg.innerHTML = `오늘 <b>${esc(tab.label)}</b>에는 <b>${esc(lbl)}</b> 판정을 받은 상품이 없습니다.<br>
      판정은 관측이 쌓이면 매 회차 갱신되니 내일 다시 확인해 보세요.`;
  } else eg.classList.add('hidden');
  $('#grid').innerHTML = items.map(it=>{
    const [cls,label] = VCHIP[gradeOf(it)] || VCHIP.watch;
    const ftags = flagsOf(it).map(fl=>`<span class="fchip">${FCHIP[fl]||fl}</span>`).join('');
    const dc = (it.org && it.org > it.cur) ? Math.round((1-it.cur/it.org)*100) : 0;
    const thumb = it.img
      ? `<img src="${esc(it.img)}" alt="" loading="lazy" onerror="this.parentNode.textContent='${esc((it.brand||'·').slice(0,1))}'">`
      : esc((it.brand||'·').slice(0,1));
    const first = it.series.length ? it.series[0][0] : '';
    const last  = it.series.length ? it.series[it.series.length-1][0] : '';
    return `<div class="pcard" data-g="${it.gno}">
      <div class="row1">
        <span class="rank ${it.rank<=3?'top':''}">${it.rank}</span>
        <span class="vchip ${cls}" title="${VEN[gradeOf(it)]||''}">${label}</span>${ftags}
      </div>
      <div class="phead">
        <div class="pthumb">${thumb}</div>
        <div class="pmeta">
          <div class="brand">${esc(it.brand)}</div>
          <a class="name" href="${esc(it.aff)}" target="_blank" rel="noopener"
             title="올리브영 상품 페이지 (제휴 링크)">${esc(it.name)} <span class="ext">↗</span></a>
        </div>
      </div>
      <div class="price">
        <span class="cur">${won(it.cur)}</span>${realTag(it)}
        ${shownLine(it)}
      </div>
      <div class="spark">${spark(it)}</div>
      <div class="xlab"><span>${first}</span><span>오늘 ${last}</span></div>
    </div>`;
  }).join('');
  bind(view);
  syncChips();
  syncUrl();
}

/* ---------- 이벤트 ---------- */
const tt = $('#tt');
function bind(tab){
  document.querySelectorAll('.pcard').forEach(card=>{
    const it = tab.items.find(x=>x.gno===card.dataset.g);
    const svg = card.querySelector('svg');
    if(svg && it && it.series.length){
      svg.addEventListener('mousemove', ev=>{
        const box = svg.getBoundingClientRect();
        const sx = (ev.clientX-box.left)*(CW/box.width);
        const n = it.series.length;
        let bi = n>1 ? Math.round((sx-L)/((CW-L-R)/(n-1))) : 0;
        bi = Math.max(0, Math.min(n-1, bi));
        tt.style.display='block';
        tt.style.left = ev.clientX+'px';
        tt.style.top  = ev.clientY+'px';
        tt.innerHTML = `${it.series[bi][0]} · <b>${won(it.series[bi][1])}</b>`;
      });
      svg.addEventListener('mouseleave', ()=> tt.style.display='none');
    }
    /* 판정서로 이동 — 지금 보던 필터를 함께 넘겨, 되돌아올 때 같은 화면으로 복귀한다 */
    card.addEventListener('click', ()=>{
      let u = './?g=' + card.dataset.g + '&from=price';
      if(state.cat!=='all') u += '&fcat=' + encodeURIComponent(state.cat);
      if(state.v) u += '&fv=' + encodeURIComponent(state.v);
      location.href = u;
    });
  });
  document.querySelectorAll('a.name').forEach(a=>
    a.addEventListener('click', e=>e.stopPropagation()));
}

/* ---------- 카테고리 탭 ---------- */
$('#cat-chips').innerHTML = TABS.map(t=>
  `<button class="chip" data-key="${t.key}">${t.label}</button>`).join('');
document.querySelectorAll('#cat-chips .chip').forEach(ch=>{
  ch.addEventListener('click', ()=>{ state.cat = ch.dataset.key; render(); });
});

/* ---------- 판정 탭 ---------- */
/* 칩은 현재 카테고리 탭의 실제 집계로 매번 다시 그린다 — 0건 판정을 눌러
   빈 화면을 보게 되는 일이 없도록. 단, 지금 선택된 판정은 0건이어도 남겨둔다
   (딥링크로 들어왔는데 칩이 사라져 되돌아갈 곳이 없어지면 안 되므로). */
function syncChips(){
  document.querySelectorAll('#cat-chips .chip').forEach(c=>
    c.classList.toggle('on', c.dataset.key===state.cat));
  const tab = TABS.find(t=>t.key===state.cat) || TABS[0];
  const cnt = {}, fcnt = {};
  tab.items.forEach(it=>{
    cnt[gradeOf(it)] = (cnt[gradeOf(it)]||0) + 1;
    flagsOf(it).forEach(fl=>{ fcnt[fl] = (fcnt[fl]||0) + 1; });
  });
  $('#v-chips').innerHTML =
    `<button class="vchip-btn ${state.v?'':'on'}" data-v="">전체<span class="n">${tab.items.length}</span></button>` +
    VORDER.filter(v=>cnt[v] || v===state.v).map(v=>{
      const [cls,label] = VCHIP[v];
      return `<button class="vchip-btn ${cls} ${v===state.v?'on':''}" data-v="${v}" title="${VEN[v]||''}">${label}<span class="n">${cnt[v]||0}</span></button>`;
    }).join('')
    + (FORDER.some(fl=>fcnt[fl] || fl===state.f)
        ? `<span class="fsep">표시가 주의</span>` + FORDER.filter(fl=>fcnt[fl] || fl===state.f).map(fl=>
            `<button class="fchip-btn ${fl===state.f?'on':''}" data-f="${fl}">${FCHIP[fl]}<span class="n">${fcnt[fl]||0}</span></button>`).join('')
        : '');
  document.querySelectorAll('#v-chips .vchip-btn').forEach(ch=>{
    ch.addEventListener('click', ()=>{ state.v = ch.dataset.v; render(); });
  });
  document.querySelectorAll('#v-chips .fchip-btn').forEach(ch=>{
    ch.addEventListener('click', ()=>{ state.f = (state.f===ch.dataset.f ? '' : ch.dataset.f); render(); });
  });
  const lbl = state.f ? FCHIP[state.f] : (state.v ? (VCHIP[state.v]||['',''])[1] : '');
  document.title = state.v
    ? `더마릭 — ${lbl.replace(/^[✓✕!↑]\s*/,'')} · ${tab.label} 실제 가격`
    : '더마릭 — 가격 데이터 · 오늘의 올영 랭킹 실제 가격';
  $('#filter-note').innerHTML = (state.v || state.f)
    ? `<b>${esc(tab.label)}</b> 중 <b>${esc(lbl)}</b>${state.v&&state.f?' + 표시가 주의':''}만 보고 있습니다 · <button class="linkish" id="clear-v">전체 보기</button>`
    : '';
  const cv = $('#clear-v');
  if(cv) cv.addEventListener('click', ()=>{ state.v=''; state.f=''; render(); });
}

/* 주소로 상태를 유지 — 티저 칩 딥링크(?v=inflated)와 공유 링크가 같은 화면을 연다 */
function syncUrl(){
  const p = new URLSearchParams();
  if(state.cat!=='all') p.set('cat', state.cat);
  if(state.v) p.set('v', state.v);
  if(state.f) p.set('f', state.f);
  const qs = p.toString();
  history.replaceState(null, '', qs ? '?'+qs : location.pathname);
}
