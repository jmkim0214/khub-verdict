rt;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:44px;letter-spacing:.18em;color:#596044;border:3px solid #596044;border-radius:12px;padding:18px 40px}\n.ul{display:flex;flex-direction:column;gap:22px} .ul>div{display:flex;gap:22px;font-size:30px;line-height:1.45;color:#5B5D55} .ul>div b{color:#20221E} .ul .n{flex:none;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:44px;color:#596044;line-height:1.1;width:44px}\n"}</script><script>
const saleData=JSON.parse(document.getElementById('sale-data').textContent);
const saleDialog=document.getElementById('sale-viewer');
let saleReport=0,salePage=0,saleOpener=null;
const shadowStyle=saleData.css+'\n:host{display:block;overflow:hidden}*{box-sizing:border-box;margin:0;padding:0}.k{position:absolute;left:0;top:0;transform-origin:0 0}';
function mountCard(host,html){
 const shadow=host.shadowRoot||host.attachShadow({mode:'open'});
 shadow.innerHTML='<style>'+shadowStyle+'</style><div style="position:relative;width:100%;height:100%">'+html+'</div>';
 const fit=()=>{const k=shadow.querySelector('.k');k.style.transform='scale('+(host.clientWidth/1080)+')';};
 if(!host.cardObserver){host.cardObserver=new ResizeObserver(fit);host.cardObserver.observe(host);}
 fit();
}
document.querySelectorAll('.sale-tile').forEach((button,i)=>{
 mountCard(button.querySelector('.sale-cover'),saleData.reports[i].cards[0]);
 button.addEventListener('click',()=>{saleReport=i;salePage=0;saleOpener=button;saleDialog.showModal();document.body.style.overflow='hidden';renderSale();});
});
function renderSale(){
 const report=saleData.reports[saleReport];
 document.getElementById('sale-viewer-title').textContent=report.title;
 mountCard(document.getElementById('sale-viewer-card'),report.cards[salePage]);
 document.getElementById('sale-counter').textContent=(salePage+1)+' / '+report.cards.length;
 document.getElementById('sale-prev').disabled=salePage===0;
 document.getElementById('sale-next').disabled=salePage===report.cards.length-1;
 document.getElementById('sale-method-text').textContent=report.method;
 document.getElementById('sale-method').open=false;
}
function stepSale(delta){let next=salePage+delta;if(next>=0&&next<saleData.reports[saleReport].cards.length){salePage=next;renderSale();}}
document.getElementById('sale-prev').onclick=()=>stepSale(-1);
document.getElementById('sale-next').onclick=()=>stepSale(1);
document.getElementById('sale-close').onclick=()=>saleDialog.close();
saleDialog.addEventListener('close',()=>{document.body.style.overflow='';saleOpener?.focus();});
saleDialog.addEventListener('click',e=>{if(e.target===saleDialog){const r=saleDialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)saleDialog.close();}});
document.addEventListener('keydown',e=>{if(saleDialog.open&&(e.key==='ArrowRight'||e.key==='ArrowLeft')){e.preventDefault();stepSale(e.key==='ArrowRight'?1:-1);}});
let touchStart=null;
const swipeArea=document.getElementById('sale-viewer-card');
swipeArea.addEventListener('touchstart',e=>{touchStart=[e.touches[0].clientX,e.touches[0].clientY];},{passive:true});
swipeArea.addEventListener('touchend',e=>{if(!touchStart)return;const dx=e.changedTouches[0].clientX-touchStart[0],dy=e.changedTouches[0].clientY-touchStart[1];if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy))stepSale(dx<0?1:-1);touchStart=null;},{passive:true});
function syncSaleTab(){selectReport(document.getElementById(location.hash==='#brand'?'tab-brand':'tab-sale'));}
reportTabs.forEach(tab=>tab.addEventListener('click',()=>history.replaceState(null,'',tab.id==='tab-sale'?'#sale':'#brand')));
window.addEventListener('hashchange',syncSaleTab);syncSaleTab();
</script></body></html>