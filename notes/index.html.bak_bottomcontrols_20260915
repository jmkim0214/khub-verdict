const saleReports=JSON.parse(document.getElementById('sale-data').textContent);
const gallery=document.getElementById('sale-gallery');
const reader=document.getElementById('sale-reader');
let lastReport=null;
const salePages=document.getElementById('sale-pages');
const salePrev=document.getElementById('sale-prev');
const saleNext=document.getElementById('sale-next');
let saleIndex=0;
function cardStride(){return salePages.clientWidth+parseFloat(getComputedStyle(salePages).columnGap||0);}
function updateSalePager(){
 saleIndex=Math.max(0,Math.min(salePages.children.length-1,Math.round(salePages.scrollLeft/cardStride())));
 document.getElementById('sale-position').textContent=(saleIndex+1)+' / '+salePages.children.length;
 salePrev.disabled=saleIndex===0;saleNext.disabled=saleIndex===salePages.children.length-1;
}
function moveSaleCard(delta){
 const index=Math.max(0,Math.min(salePages.children.length-1,saleIndex+delta));
 salePages.scrollTo({left:index*cardStride(),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
}
salePages.addEventListener('scroll',updateSalePager,{passive:true});
salePrev.addEventListener('click',()=>moveSaleCard(-1));saleNext.addEventListener('click',()=>moveSaleCard(1));
reader.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();moveSaleCard(e.key==='ArrowRight'?1:-1);}});
new ResizeObserver(()=>{if(!reader.hidden){salePages.scrollTo({left:saleIndex*cardStride(),behavior:'instant'});updateSalePager();}}).observe(salePages);
function saleRoute(){
 const key=location.hash.startsWith('#sale/')?location.hash.slice(6):null;
 const report=saleReports.find(r=>r.key===key);
 selectReport(document.getElementById(location.hash==='#brand'?'tab-brand':'tab-sale'));
 gallery.hidden=!!report;reader.hidden=!report;
 if(report){
  lastReport=report.key;
  document.getElementById('sale-reader-title').textContent=report.title;
  document.getElementById('sale-reader-lead').textContent=report.lead;
  document.getElementById('sale-method-text').textContent=report.method;
  document.getElementById('sale-method').open=false;
  const pages=document.getElementById('sale-pages');pages.replaceChildren();
  report.images.forEach((image,i)=>{
   const figure=document.createElement('figure');figure.className='sale-page';
   const img=document.createElement('img');img.src=image.src;img.width=image.width;img.height=image.height;img.alt=report.title+' — '+(i+1)+' / '+report.images.length;img.loading=i===0?'eager':'lazy';img.decoding='async';
   const caption=document.createElement('figcaption');
   const count=document.createElement('span');count.textContent=(i+1)+' / '+report.images.length;
   const link=document.createElement('a');link.href=image.src;link.target='_blank';link.rel='noopener';link.textContent='원본 크게 보기';link.setAttribute('aria-label',(i+1)+'번째 카드 원본 크게 보기 (새 탭)');
   caption.append(count,link);figure.append(img,caption);pages.append(figure);
  });
  saleIndex=0;pages.scrollTo({left:0,behavior:'instant'});updateSalePager();
  reader.scrollIntoView({block:'start'});document.getElementById('sale-reader-title').focus({preventScroll:true});
 }else if(lastReport&&location.hash==='#sale'){
  const tile=document.getElementById('sale-tile-'+lastReport);tile?.focus({preventScroll:true});tile?.scrollIntoView({block:'center'});
 }
}
reportTabs.forEach(tab=>tab.addEventListener('click',()=>{const hash=tab.id==='tab-sale'?'#sale':'#brand';if(location.hash!==hash)location.hash=hash;else saleRoute();}));
window.addEventListener('hashchange',saleRoute);saleRoute();
</script></body></html>